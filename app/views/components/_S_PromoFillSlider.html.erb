<div class="S_PromoFillSlider" data-controller="promo-fill-slider" data-promo-fill-slider-index-value="0">
  <%= turbo_stream_from "promo_fill_rail" %>

  <div class=W_PromoFillContent>
    <div class="W_PromoFillRail" id="W_PromoFillRail" data-promo-fill-slider-target="fillRail">
      <% promo_fills.each do |fill| %>
        <%= render partial: "components/A_PromoFill", locals: { fill: fill } %>
      <% end %>
    </div>
  </div>

  <div class="W_PromoFillControls">
    <div class="W_PromoFillArrow">
      <div class="A_IconButton prev" data-promo-fill-slider-target="prevButton" data-action="click->promo-fill-slider#prevSwatch">A</div>
    </div>

    <div class="W_PromoFillMeatballs">
      <%# promo_fills.each_with_index do |fill, index| %>
        <%#= render partial: "components/A_PromoFillMeatball", locals: { index: index } %>
      <%# end %>
    </div>

    <div class="W_PromoFillArrow">
      <div class="A_IconButton next" data-promo-fill-slider-target="nextButton" data-action="click->promo-fill-slider#nextSwatch">V</div>
    </div>
  </div>
</div>